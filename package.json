{
	"name": "attack-shark-x11-driver",
	"version": "1.5.0",
	"description": "A Windows and Linux desktop configuration app for Attack Shark X11-compatible gaming mice.",
	"desktopName": "attack-shark-x11-electron",
	"author": {
		"name": "akawazak",
		"url": "https://github.com/akawazak"
	},
	"contributors": [
		{
			"name": "dressedinblack5",
			"url": "https://github.com/dressedinblack5"
		},
		{
			"name": "HarukaYamamoto0",
			"url": "https://github.com/HarukaYamamoto0"
		},
		{
			"name": "xb-bx",
			"url": "https://github.com/xb-bx"
		}
	],
	"license": "MIT",
	"homepage": "https://github.com/akawazak/attack-shark-x11-community-driver#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akawazak/attack-shark-x11-community-driver.git"
	},
	"bugs": {
		"url": "https://github.com/akawazak/attack-shark-x11-community-driver/issues"
	},
	"keywords": [
		"attack-shark",
		"x11",
		"mouse",
		"driver",
		"linux",
		"usb",
		"hid",
		"typescript"
	],
	"packageManager": "bun@1.3.14",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "node scripts/clean-output.mjs out && electron-vite build",
		"preview": "electron-vite preview",
		"package": "node scripts/clean-output.mjs out && electron-vite build && electron-builder",
		"lint": "bunx eslint . --ext .ts --cache --cache-strategy content",
		"lint:fix": "bunx eslint . --ext .ts --fix --cache --cache-strategy content",
		"format": "bunx prettier --check . --cache --cache-strategy content",
		"format:fix": "bunx prettier --write . --cache --cache-strategy content",
		"typecheck": "tsc --noEmit",
		"postinstall": "node node_modules/electron/install.js",
		"prepare": "husky",
		"test": "bun test"
	},
	"build": {
		"appId": "com.attackshark.driver",
		"productName": "Attack Shark X11 Driver",
		"artifactName": "attack-shark-x11-electron-${version}.${ext}",
		"directories": {
			"output": "dist"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "akawazak",
				"repo": "attack-shark-x11-community-driver"
			}
		],
		"files": [
			"out/**/*",
			"package.json",
			"!node_modules/usb/target/**/*",
			"!node_modules/node-hid/build/Release/**/*.iobj",
			"!node_modules/node-hid/build/Release/**/*.ipdb",
			"!node_modules/node-hid/build/Release/**/*.lib",
			"!node_modules/node-hid/build/Release/**/*.pdb",
			"!node_modules/node-hid/build/Release/**/*.exp",
			"!node_modules/node-hid/build/Release/obj/**/*",
			"!node_modules/node-hid/build/*.vcxproj*",
			"!node_modules/node-hid/hidapi/**/*",
			"!node_modules/node-hid/prebuilds/**/*",
			"!node_modules/node-hid/src/**/*",
			"!node_modules/usb/.cargo/**/*",
			"!node_modules/usb/src/**/*",
			"!node_modules/usb/tsc/**/*",
			"!node_modules/usb/dist/**/*",
			"!node_modules/usb/Cargo.*",
			"!node_modules/usb/build.rs",
			"!node_modules/usb/tsconfig.json",
			"!node_modules/usb/typedoc.json"
		],
		"nodeGypRebuild": false,
		"nativeRebuilder": "legacy",
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Settings",
			"icon": "assets/cs-mouse.svg",
			"executableName": "attack-shark-x11-electron",
			"extraResources": [
				{
					"from": "assets/70-attack-shark-x11.rules",
					"to": "70-attack-shark-x11.rules"
				}
			],
			"files": [
				"!node_modules/node-hid/**/*"
			],
			"syncDesktopName": true
		},
		"deb": {
			"afterInstall": "scripts/deb-after-install.sh",
			"afterRemove": "scripts/deb-after-remove.sh"
		},
		"win": {
			"files": [
				"!node_modules/usb/**/*"
			],
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/attack-shark-x11-logo-2026.png"
		},
		"nsis": {
			"artifactName": "attack-shark-x11-electron-${version}-setup.${ext}",
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Attack Shark X11 Driver"
		},
		"portable": {
			"artifactName": "attack-shark-x11-electron-${version}-portable.${ext}"
		}
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"dependencies": {
		"@electron-toolkit/utils": "^4.0.0",
		"lucide-vue-next": "^1.0.0",
		"node-hid": "^3.4.0",
		"usb": "github:dressedinblack5/node-usb-rs#1b58772b7be558a12bd23616d20fcc20dab74436",
		"vue": "^3.5.41",
		"vue-i18n": "^11.4.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"@vitejs/plugin-vue": "^6.0.8",
		"app-builder-lib": "26.15.7",
		"brace-expansion": "1.1.18",
		"builder-util-runtime": "9.7.0",
		"electron": "42.9.2",
		"electron-builder": "26.15.7",
		"electron-vite": "^5.0.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"fast-uri": "3.1.5",
		"form-data": "4.0.6",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"js-yaml": "4.3.1",
		"lint-staged": "^17.3.0",
		"prettier": "3.8.4",
		"tar": "7.5.22",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"undici": "7.29.0",
		"vite": "7.3.6"
	},
	"trustedDependencies": [
		"usb"
	]
}
